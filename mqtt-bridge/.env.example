# ── MQTT ────────────────────────────────────────────────────────────────
MQTT_HOST=192.168.4.4
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# Para descubrir: '#' escucha todo. Una vez identificado el tópico de la
# balanza, acotalo (p. ej. balanza/# o esphome/bascula/#) para no procesar
# el tráfico de Frigate y del PS5.
MQTT_TOPIC=#

# ── NutriTrace ──────────────────────────────────────────────────────────
# Desde otro contenedor, 127.0.0.1 apunta al propio contenedor: usar la IP
# del host o el nombre del servicio en la red de compose.
NT_URL=http://192.168.4.4:3001
# Ajustes → API tokens → nuevo token con el scope write:body-measurements.
NT_TOKEN=
SOURCE=mqtt-balanza

# discover = sólo mostrar lo que llega | run = mapear y enviar
MODE=discover
# DRY_RUN=1 mapea y muestra el JSON final sin mandarlo. Útil para verificar
# el mapeo antes de escribir de verdad en el diario.
DRY_RUN=
# MAPEO_EXTRA={"peso_corporal":"weight","grasa_visceral":"visceral_fat"}
MAPEO_EXTRA={}
DEBUG=
